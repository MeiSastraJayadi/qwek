# Neon connection string in Npgsql keyword/value format, e.g.
# CONNECTION_STRING=Host=ep-xxx-pooler.region.aws.neon.tech;Database=neondb;Username=neondb_owner;Password=xxx;SSL Mode=Require;Trust Server Certificate=true
CONNECTION_STRING=

API_IMAGE=qwek:latest
BIND_ADDRESS=127.0.0.1
API_PORT=8080

JWT_ISSUER=Qwek
JWT_AUDIENCE=Qwek
# Generate with: openssl rand -base64 48
JWT_KEY=
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=30

# Comma-separated list, e.g. https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=

# Requires `docker compose --profile antivirus up -d`
ANTIVIRUS_ENABLED=false
ANTIVIRUS_HOST=clamav
ANTIVIRUS_PORT=3310
ANTIVIRUS_TIMEOUT_SECONDS=30

# Local disk storage is the default. MaxTotalBytes is the hard cap for all uploads.
STORAGE_PROVIDER=Local
# Set true for private buckets; files are served through /api/files with auth
STORAGE_PRIVATE=false
STORAGE_PRIVATE_BASE_PATH=/api/files
STORAGE_MAX_TOTAL_BYTES=9000000000
STORAGE_MAX_USER_BYTES=524288000
STORAGE_MAX_ATTACHMENT_BYTES=26214400
STORAGE_MAX_AVATAR_BYTES=5242880
STORAGE_LOCAL_PATH=uploads
STORAGE_LOCAL_PUBLIC_BASE_PATH=/uploads

# Set STORAGE_PROVIDER=S3 for Cloudflare R2 or another S3-compatible service.
STORAGE_S3_BUCKET=
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=auto
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_PUBLIC_BASE_URL=
